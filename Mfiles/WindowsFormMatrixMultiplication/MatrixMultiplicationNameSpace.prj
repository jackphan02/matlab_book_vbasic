  <MCCProperties>
    <output></output>
    <wrapper>
      <type>dotnet</type>
      <component_name>MatrixMultiplicationNameSpace</component_name>
      <default_class>MatrixMultiplication</default_class>
      <additionalProperty>2.0</additionalProperty>
      <additionalProperty>$(PROJECTDIR)\encryption_keyfile_path</additionalProperty>
      <additionalProperty>local</additionalProperty>
    </wrapper>
    <link>lib</link>
    <create_vb_wrapper>false</create_vb_wrapper>
    <intermediate_dir>$(PROJECTDIR)\</intermediate_dir>
    <output_dir>$(PROJECTDIR)\</output_dir>
    <generate_code_only>false</generate_code_only>
    <verbose>false</verbose>
    <create_CTF>true</create_CTF>
    <MCR_runtime_options>
      <share_mcr>false</share_mcr>
    </MCR_runtime_options>
    <options_file></options_file>
    <toolboxes_on_path shortcut="all"/>
    <debug>false</debug>
    <warning shortcut="default"/>
    <license_file></license_file>
  </MCCProperties>

  <file_info>
